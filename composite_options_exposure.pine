vixCallsStr = input.string(vixCallsDefault, "VIX Call_Exposure CSV", group=groupData)
vixPutsStr = input.string(vixPutsDefault, "VIX Put_Exposure CSV", group=groupData)

esStrikesCSV = useOverrides ? esStrikesStr : esStrikesDefault
esCallsCSV = useOverrides ? esCallsStr : esCallsDefault
