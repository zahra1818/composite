//@version=6
// Author: Zahra Talan
// Composite Options Exposure - INTELLIGENT MAGNET v7.4
// Build: Dec 12, 2025 (Clear SKEW Language + Table Updates Independent of Profile)

indicator("Composite Options Exposure (Intelligent) v7.4b",
     overlay=true,
     max_lines_count=500,
     max_labels_count=500)

// ================= Display Settings
groupMain = "Display Settings"

showProfile = input.bool(true, "Show Exposure Profile", group=groupMain)
profileBars = input.int(40, "Profile Width RIGHT (bars)", minval=10, maxval=150, group=groupMain)
profileBarsLeft = input.int(100, "Profile Width LEFT (bars)", minval=20, maxval=300, group=groupMain)
minExposure = input.float(0.30, "Min Exposure to Display (% of max)", minval=0.05, maxval=1.00, step=0.05, group=groupMain)
snapToES5 = input.bool(true, "Snap mapped strikes to ES 5-pt grid", group=groupMain)

showOnlyWindow = input.bool(true, "Only show levels within a price window", group=groupMain)
windowPts = input.int(120, "Window half-width (ES points)", minval=5, maxval=500, group=groupMain)

useTopPercentile = input.bool(true, "Use Top Percentile Filter (keeps largest N%)", group=groupMain)
topPercent = input.float(5.0, "Top Percentile to Display (%)", minval=1, maxval=100, step=1, group=groupMain)

clusterLines = input.bool(true, "Cluster nearby minor levels", group=groupMain)
clusterDistPts = input.int(2, "Cluster distance (pts)", minval=1, maxval=20, group=groupMain)
clusterMinRatio = input.float(0.35, "Cluster skip threshold", minval=0.05, maxval=1.0, step=0.05, group=groupMain)

callColorBase = input.color(color.new(color.lime, 0), "Call exposure color", group=groupMain)
putColorBase = input.color(color.new(color.red, 0), "Put exposure color", group=groupMain)

// ================= Magnet Logic
groupMag = "Magnet Logic (Smart Filter)"
useMagFilter = input.bool(true, "Filter Magnets based on Flow?", group=groupMag)
magBiasThresh = input.int(20, "Bias Threshold (+/-)", tooltip="If Bias is worse than this against the magnet direction, kill the signal.", group=groupMag)

// ================= Instrument weights
groupInstruments = "Instrument Weights"
wES = input.float(1.00, "ES weight", minval=0.0, maxval=5.0, step=0.05, group=groupInstruments)
wSPX = input.float(0.80, "SPX weight", minval=0.0, maxval=5.0, step=0.05, group=groupInstruments)
wSPY = input.float(0.45, "SPY weight", minval=0.0, maxval=5.0, step=0.05, group=groupInstruments)
wNQ = input.float(0.50, "NQ weight", minval=0.0, maxval=5.0, step=0.05, group=groupInstruments)

// ================= Strike mappings
groupMap = "Strike Mapping"
nqToES = input.float(0.268, "NQ -> ES ratio", minval=0.10, maxval=0.60, step=0.001, group=groupMap)
spyToES = input.float(10.0, "SPY -> ES ratio", minval=5.00, maxval=15.0, step=0.1, group=groupMap)
spxToES = input.float(1.00, "SPX -> ES ratio", minval=0.90, maxval=1.10, step=0.01, group=groupMap)

// ================= VIX Settings
groupVIX = "VIX Settings"
vixSymbol = input.string("CBOE:VIX", "VIX symbol", group=groupVIX)

// ================= Wall Detection
groupWalls = "Wall Detection"
wallStrengthPct = input.float(0.50, "Wall strength threshold (%)", minval=0.20, maxval=0.90, step=0.05, group=groupWalls)
pinRadiusPts = input.int(25, "Pin radius (pts)", minval=5, maxval=200, group=groupWalls)
showWallLines = input.bool(true, "Draw wall lines", group=groupWalls)

// ================= Data Overrides
groupData = "Data Overrides"
useOverrides = input.bool(true, "Use pasted datasets", group=groupData)
buildKey = input.int(0, "Rebuild key", group=groupData)

