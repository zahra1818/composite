spyCallsStr = input.string(spyCallsDefault, "SPY_Call_Exposure CSV", group=groupData)
spyPutsStr = input.string(spyPutsDefault, "SPY_Put_Exposure CSV", group=groupData)

nqStrikesStr = input.string(nqStrikesDefault, "NQ_Strikes CSV", group=groupData)
nqCallsStr = input.string(nqCallsDefault, "NQ_Call_Exposure CSV", group=groupData)
nqPutsStr = input.string(nqPutsDefault, "NQ_Put_Exposure CSV", group=groupData)

