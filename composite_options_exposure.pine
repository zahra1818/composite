// ================= Utilities
csv_to_float_array(s) =>
    out = array.new_float()
    if str.length(s) > 0
        parts = str.split(s, ",")
        sz = array.size(parts)
        if sz > 0
            for i = 0 to sz - 1
                tok = str.trim(array.get(parts, i))
                val = str.tonumber(tok)
                array.push(out, na(val) ? 0.0 : val)
    out

max_abs(arr) =>
    m = 0.0
    sz = array.size(arr)
    if sz > 0
        for i = 0 to sz - 1
            m := math.max(m, math.abs(array.get(arr, i)))
    m

sum_arr(arr) =>
    s = 0.0
    sz = array.size(arr)
    if sz > 0
        for i = 0 to sz - 1
            s += array.get(arr, i)
    s

sum_abs_arr(arr) =>
    s = 0.0
    sz = array.size(arr)
    if sz > 0
        for i = 0 to sz - 1
            s += math.abs(array.get(arr, i))
    s

net_from(callArr, putArr) =>
    n = math.min(array.size(callArr), array.size(putArr))
    out = array.new_float(n, 0.0)
    if n > 0
        for i = 0 to n - 1
            array.set(out, i, array.get(callArr, i) - array.get(putArr, i))
    out

fmt2(v) =>
    str.tostring(v, "#.##")

fmtInt(v) =>
    str.tostring(int(math.round(v)))

scale_to_ref(arr, refMax_, weight) =>
    n = array.size(arr)
    ma = max_abs(arr)
    out = array.new_float(n, 0.0)
    if n > 0 and ma != 0.0 and refMax_ != 0.0
        for i = 0 to n - 1
            v = array.get(arr, i)
            base = v / ma
            array.set(out, i, base * refMax_ * weight)
    out

to_es_strike(srcStrike, ratio, snap5) =>
    mapped = srcStrike * ratio
    snap5 ? math.round(mapped / 5.0) * 5.0 : mapped

add_to_map(_map, strike, exposure) =>
    cur = map.contains(_map, strike) ? map.get(_map, strike) : 0.0
    map.put(_map, strike, cur + exposure)

// ================= Globals
var exposureMap = map.new<float, float>()
var callExpMap = map.new<float, float>()
var putExpMap = map.new<float, float>()
var float vixProp = na
var float refMax = na

// 10 essential metrics
var float biasScoreLast = na
var string gammaRegimeLast = "NA"
var string vannaFlowLast = "NA"
var float supportLevelLast = na
var float resistLevelLast = na
var float magnetLevelLast = na
var bool magnetValidLast = true
var string regimeLast = "NA"
var float transitionStrikeLast = na
var float pcRatioLast = na

// Clear-language skew
var string skewLast = "NA"
var int skewDirLast = 0  // -1 = bearish/overhead, 0 = balanced, +1 = bullish/downside

var float putWallDistLast = na
var float callWallDistLast = na
var float magnetDistLast = na
var float pinIndexLast = na

var linesArr = array.new_line()
var labelsArr = array.new_label()
var line putWallLine = na
var line callWallLine = na
var label putWallLabel = na
var label callWallLabel = na
var label magnetLabel = na

// ================= Clear function for arrays only
clear_arrays() =>
    lnCount = array.size(linesArr)
    if lnCount > 0
        for i = 0 to lnCount - 1
            line.delete(array.get(linesArr, i))
    array.clear(linesArr)

    lbCount = array.size(labelsArr)
    if lbCount > 0
        for j = 0 to lbCount - 1
            label.delete(array.get(labelsArr, j))
    array.clear(labelsArr)

make_line(x1, y1, x2, y2, colr, wid) =>
    ln = line.new(x1, y1, x2, y2, color=colr, width=wid)
    array.push(linesArr, ln)

make_label(x, y, txt, colr, tcolr) =>
    lb = label.new(x, y, txt, style=label.style_label_left, color=colr, textcolor=tcolr, size=size.tiny)
    array.push(labelsArr, lb)

vixLevelGlobal = request.security(vixSymbol, "D", close)

// ================= Rebuild
var int _prevBuildKey = na
_needRebuild = barstate.isfirst or (buildKey != _prevBuildKey)

if _needRebuild
    _prevBuildKey := buildKey
    map.clear(exposureMap)
    map.clear(callExpMap)
    map.clear(putExpMap)

    esK = csv_to_float_array(esStrikesCSV)
    esC = csv_to_float_array(esCallsCSV)
    esP = csv_to_float_array(esPutsCSV)

    spxK = csv_to_float_array(spxStrikesCSV)
    spxC = csv_to_float_array(spxCallsCSV)
    spxP = csv_to_float_array(spxPutsCSV)

    spyK = csv_to_float_array(spyStrikesCSV)
    spyC = csv_to_float_array(spyCallsCSV)
    spyP = csv_to_float_array(spyPutsCSV)

    nqK = csv_to_float_array(nqStrikesCSV)
    nqC = csv_to_float_array(nqCallsCSV)
    nqP = csv_to_float_array(nqPutsCSV)

    esNet = net_from(esC, esP)
    spxNet = net_from(spxC, spxP)
    spyNet = net_from(spyC, spyP)
    nqNet = net_from(nqC, nqP)

    refMax := math.max(1e-9, max_abs(esNet))

    esScaled = scale_to_ref(esNet, refMax, wES)
    spxScaled = scale_to_ref(spxNet, refMax, wSPX)
    spyScaled = scale_to_ref(spyNet, refMax, wSPY)
    nqScaled = scale_to_ref(nqNet, refMax, wNQ)

    esCScaled = scale_to_ref(esC, refMax, wES)
    esPScaled = scale_to_ref(esP, refMax, wES)
    spxCScaled = scale_to_ref(spxC, refMax, wSPX)
    spxPScaled = scale_to_ref(spxP, refMax, wSPX)
    spyCScaled = scale_to_ref(spyC, refMax, wSPY)
    spyPScaled = scale_to_ref(spyP, refMax, wSPY)
    nqCScaled = scale_to_ref(nqC, refMax, wNQ)
    nqPScaled = scale_to_ref(nqP, refMax, wNQ)

    nES = math.min(array.size(esK), array.size(esScaled))
    nSPX = math.min(array.size(spxK), array.size(spxScaled))
    nSPY = math.min(array.size(spyK), array.size(spyScaled))
    nNQ = math.min(array.size(nqK), array.size(nqScaled))

    if nES > 0
        for i = 0 to nES - 1
            strike = array.get(esK, i)
            add_to_map(exposureMap, strike, array.get(esScaled, i))
            add_to_map(callExpMap, strike, array.get(esCScaled, i))
            add_to_map(putExpMap, strike, array.get(esPScaled, i))

    if nSPX > 0
        for i = 0 to nSPX - 1
            k = to_es_strike(array.get(spxK, i), spxToES, snapToES5)
            add_to_map(exposureMap, k, array.get(spxScaled, i))
            add_to_map(callExpMap, k, array.get(spxCScaled, i))
            add_to_map(putExpMap, k, array.get(spxPScaled, i))

    if nSPY > 0
        for i = 0 to nSPY - 1
            k = to_es_strike(array.get(spyK, i), spyToES, snapToES5)
            add_to_map(exposureMap, k, array.get(spyScaled, i))
            add_to_map(callExpMap, k, array.get(spyCScaled, i))
            add_to_map(putExpMap, k, array.get(spyPScaled, i))

    if nNQ > 0
        for i = 0 to nNQ - 1
            k = to_es_strike(array.get(nqK, i), nqToES, snapToES5)
            add_to_map(exposureMap, k, array.get(nqScaled, i))
            add_to_map(callExpMap, k, array.get(nqCScaled, i))
            add_to_map(putExpMap, k, array.get(nqPScaled, i))

    vC = csv_to_float_array(vixCallsCSV)
    vP = csv_to_float_array(vixPutsCSV)
    vNet = sum_arr(vP) - sum_arr(vC)
    vTot = sum_abs_arr(vC) + sum_abs_arr(vP)
    vixProp := vTot > 0.0 ? vNet / vTot : na

// ================= Metrics + Drawing
var bool profileDrawn = false
if barstate.isnew
    profileDrawn := false

// IMPORTANT FIX: metrics update regardless of showProfile
if barstate.islast and not profileDrawn
    biasScoreLast := na
    gammaRegimeLast := "NA"
    vannaFlowLast := "NA"
    supportLevelLast := na
    resistLevelLast := na
    magnetLevelLast := na
    magnetValidLast := true
    regimeLast := "NA"
    transitionStrikeLast := na
    pcRatioLast := na
    skewLast := "NA"
    skewDirLast := 0

    putWallDistLast := na
    callWallDistLast := na
    magnetDistLast := na
    pinIndexLast := na

    // Clear arrays via function
    clear_arrays()

    // Clear wall/magnet drawings directly (not in function)
    if not na(putWallLine)
        line.delete(putWallLine)
    putWallLine := na

    if not na(callWallLine)
        line.delete(callWallLine)
    callWallLine := na

    if not na(putWallLabel)
        label.delete(putWallLabel)
    putWallLabel := na

    if not na(callWallLabel)
        label.delete(callWallLabel)
    callWallLabel := na

    if not na(magnetLabel)
        label.delete(magnetLabel)
    magnetLabel := na

    keys = map.keys(exposureMap)
    array.sort(keys, order.ascending)
    nK = array.size(keys)

    curK = math.round(close / 5.0) * 5.0
    useWin = showOnlyWindow
    lowWin = curK - windowPts
    highWin = curK + windowPts

    maxExp = 0.0
    if nK > 0
        for i = 0 to nK - 1
            k = array.get(keys, i)
            inRng = not useWin or (k >= lowWin and k <= highWin)
            if inRng
                e = map.get(exposureMap, k)
                maxExp := math.max(maxExp, math.abs(e))

    float totalCallExp = 0.0
    float totalPutExp = 0.0
    float totalAbs = 0.0
    float pinnedAbs = 0.0
    float maxCallExp = 0.0
    float maxPutExp = 0.0

    float callExpAbove = 0.0
    float callExpBelow = 0.0
    float putExpAbove = 0.0
    float putExpBelow = 0.0

    float lastNetExp = na
    float transitionK = na

    if nK > 0
        for i = 0 to nK - 1
            k = array.get(keys, i)
            inRng = not useWin or (k >= lowWin and k <= highWin)
            if inRng
                cExp = map.contains(callExpMap, k) ? map.get(callExpMap, k) : 0.0
                pExp = map.contains(putExpMap, k) ? map.get(putExpMap, k) : 0.0
                netE = map.get(exposureMap, k)

                totalCallExp += cExp
                totalPutExp += pExp
                totalAbs += math.abs(netE)
                maxCallExp := math.max(maxCallExp, cExp)
                maxPutExp := math.max(maxPutExp, pExp)

                if k > curK
                    callExpAbove += cExp
                    putExpAbove += pExp
                else
                    callExpBelow += cExp
                    putExpBelow += pExp

                if not na(lastNetExp) and lastNetExp < 0 and netE > 0
                    transitionK := k
                lastNetExp := netE

                if math.abs(k - curK) <= pinRadiusPts
                    pinnedAbs += math.abs(netE)

    transitionStrikeLast := transitionK

    if totalAbs > 0
        pinIndexLast := (pinnedAbs / totalAbs) * 100.0

    // === ROW 9: P/C RATIO ===
    if totalCallExp > 0
        pcRatioLast := totalPutExp / totalCallExp
    else
        pcRatioLast := na

    // === ROW 10: SKEW (CLEAR LANGUAGE) ===
    float overhead = callExpAbove + putExpAbove
    float downside = callExpBelow + putExpBelow
    float totalSkew = overhead + downside

    if totalSkew > 0
        float skewRatio = (downside - overhead) / totalSkew
        float skewPct = skewRatio * 100.0

        if skewRatio > 0.15
            skewDirLast := 1
            skewLast := "BULLISH (BELOW +" + fmtInt(skewPct) + "%)"
        else if skewRatio < -0.15
            skewDirLast := -1
            skewLast := "BEARISH (ABOVE +" + fmtInt(math.abs(skewPct)) + "%)"
        else
            skewDirLast := 0
            skewLast := "BALANCED"
    else
        skewDirLast := 0
        skewLast := "N/A"

    // === FIND WALLS AND MAGNET ===
    float nearestPutWallBelow = na
    float nearestPutWallDist = 1e10
    float nearestCallWallAbove = na
    float nearestCallWallDist = 1e10
    float magnetK = na
    float magnetE = 0.0

    float callWallThr = maxCallExp * wallStrengthPct
    float putWallThr = maxPutExp * wallStrengthPct

    if nK > 0
        for i = 0 to nK - 1
            k = array.get(keys, i)
            inRng = not useWin or (k >= lowWin and k <= highWin)
            if inRng
                cExp = map.contains(callExpMap, k) ? map.get(callExpMap, k) : 0.0
                pExp = map.contains(putExpMap, k) ? map.get(putExpMap, k) : 0.0
                netE = map.get(exposureMap, k)
                absE = math.abs(netE)

                if absE > magnetE
                    magnetE := absE
                    magnetK := k

                if k < curK and pExp >= putWallThr
                    dist = curK - k
                    if dist < nearestPutWallDist
                        nearestPutWallDist := dist
                        nearestPutWallBelow := k

                if k > curK and cExp >= callWallThr
                    dist = k - curK
                    if dist < nearestCallWallDist
                        nearestCallWallDist := dist
                        nearestCallWallAbove := k

    supportLevelLast := nearestPutWallBelow
    resistLevelLast := nearestCallWallAbove
    magnetLevelLast := magnetK
    putWallDistLast := not na(nearestPutWallBelow) ? curK - nearestPutWallBelow : na
    callWallDistLast := not na(nearestCallWallAbove) ? nearestCallWallAbove - curK : na
    magnetDistLast := not na(magnetK) ? magnetK - curK : na

    // === BIAS SCORE ===
    float transitionBias = 0.0
    if not na(transitionK)
        float distFromTrans = curK - transitionK
        transitionBias := math.max(-1.0, math.min(1.0, distFromTrans / 50.0))

    float wallBias = 0.0
    if not na(putWallDistLast) and not na(callWallDistLast)
        wallBias := (putWallDistLast - callWallDistLast) / (putWallDistLast + callWallDistLast)
    else if not na(putWallDistLast) and na(callWallDistLast)
        wallBias := 0.3
    else if na(putWallDistLast) and not na(callWallDistLast)
        wallBias := -0.3

    float aboveBelowBias = 0.0
    float totalAbove = callExpAbove + putExpAbove
    float totalBelow = callExpBelow + putExpBelow
    if totalAbove + totalBelow > 0
        aboveBelowBias := (totalBelow - totalAbove) / (totalAbove + totalBelow)

    float vixBias = 0.0
    if not na(vixProp)
        vixBias := -vixProp * 0.5

    float rawBias = (transitionBias * 0.40) +
         (wallBias * 0.30) +
         (aboveBelowBias * 0.20) +
         (vixBias * 0.10)

    biasScoreLast := rawBias * 100.0

    // === GAMMA REGIME ===
    float netGammaScore = 0.0
    if totalCallExp + totalPutExp > 0
        float otmCallRatio = totalCallExp > 0 ? callExpAbove / totalCallExp : 0.5
        float otmPutRatio = totalPutExp > 0 ? putExpBelow / totalPutExp : 0.5
        netGammaScore := (otmCallRatio + otmPutRatio) / 2.0

    if netGammaScore > 0.55
        gammaRegimeLast := "SHORT γ AMPLIFY"
    else if netGammaScore < 0.45
        gammaRegimeLast := "LONG γ DAMPEN"
    else
        gammaRegimeLast := "NEUTRAL γ"

    // === VANNA FLOW ===
    if na(vixProp)
        vannaFlowLast := "NO DATA"
    else if vixProp > 0.10
        vannaFlowLast := "↓ SELL FLOW"
    else if vixProp < -0.10
        vannaFlowLast := "↑ BUY FLOW"
    else
        vannaFlowLast := "NEUTRAL"

    // === REGIME ===
    float pinThresh = 40.0
    bool isPinning = not na(pinIndexLast) and pinIndexLast >= pinThresh
    bool isTrending = not na(pinIndexLast) and pinIndexLast < 25.0
    bool isDefensive = not na(vixProp) and math.abs(vixProp) > 0.50
    bool isBearish = biasScoreLast < -15
    bool isBullish = biasScoreLast > 15

    if isDefensive
        regimeLast := "⚠ DEFENSIVE"
    else if isPinning
        regimeLast := "📌 PIN/RANGE"
    else if isTrending and isBearish
        regimeLast := "📉 TREND DOWN"
    else if isTrending and isBullish
        regimeLast := "📈 TREND UP"
    else if isTrending
        regimeLast := "📊 TREND"
    else
        regimeLast := "MIXED"

    // === MAGNET FILTER LOGIC ===
    if useMagFilter and not na(magnetLevelLast) and not na(biasScoreLast)
        bool is_short_g = gammaRegimeLast == "SHORT γ AMPLIFY"
        bool is_bull_m = magnetLevelLast > close
        bool is_bear_m = magnetLevelLast < close

        bool bias_ok_bull = biasScoreLast > -magBiasThresh
        bool bias_ok_bear = biasScoreLast < magBiasThresh

        if is_short_g
            if is_bull_m and not bias_ok_bull
                magnetValidLast := false
            if is_bear_m and not bias_ok_bear
                magnetValidLast := false

    // === DRAW PROFILE (ONLY IF ENABLED) ===
    if showProfile
        float thr = 0.0
        if useTopPercentile
            mags = array.new_float()
            for i = 0 to nK - 1
                k = array.get(keys, i)
                inRng = not useWin or (k >= lowWin and k <= highWin)
                if inRng
                    array.push(mags, math.abs(map.get(exposureMap, k)))
            sizeM = array.size(mags)
            if sizeM > 0
                array.sort(mags, order.ascending)
                q = 1.0 - topPercent / 100.0
                idx = sizeM >= 2
                     ? math.max(0, math.min(int(math.floor(q * (sizeM - 1))), sizeM - 1))
                     : 0
                thr := array.get(mags, idx)

        int madeL = 0
        int madeLab = 0
        float lastHeavyK = na
        float lastHeavyMag = 0.0

        if maxExp > 0.0 and nK > 0
            for i = 0 to nK - 1
                if madeL >= 450 or madeLab >= 150
                    break

                k = array.get(keys, i)
                inRng = not useWin or (k >= lowWin and k <= highWin)
                if not inRng
                    continue

                e = map.get(exposureMap, k)
                a = math.abs(e)

                passF = useTopPercentile
                     ? a >= thr
                     : a > maxExp * minExposure

                if clusterLines and passF and not na(lastHeavyK)
                    if math.abs(k - lastHeavyK) <= clusterDistPts and a <= lastHeavyMag * clusterMinRatio
                        passF := false

                if passF
                    f = a / maxExp
                    rw = int(math.round(f * profileBars))
                    lw = int(math.round(f * profileBarsLeft))
                    o = int(math.round(80.0 - (f * 60.0)))
                    o := o < 0 ? 0 : o > 100 ? 100 : o

                    baseCol = e > 0.0 ? callColorBase : putColorBase
                    lc = color.new(baseCol, o)

                    if madeL < 450
                        make_line(bar_index - lw, k, bar_index + rw, k, lc, 2)
                        madeL += 1
                        if a > maxExp * 0.55 and madeL < 450
                            make_line(bar_index - 10, k, bar_index + 10, k, lc, 4)
                            madeL += 1

                    if a > maxExp * 0.75 and madeLab < 150
                        make_label(bar_index + rw + 2, k,
                             str.tostring(k) + (e > 0.0 ? " C" : " P"), lc, color.white)
                        madeLab += 1

                    lastHeavyK := k
                    lastHeavyMag := a

    // === DRAW WALLS (INDEPENDENT OF PROFILE TOGGLE) ===
    if showWallLines
        if not na(supportLevelLast)
            putWallLine := line.new(bar_index - 50, supportLevelLast, bar_index + 20, supportLevelLast,
                 color=color.new(color.red, 30), width=2, style=line.style_dashed)
            putWallLabel := label.new(bar_index + 22, supportLevelLast,
                 "SUPPORT " + fmtInt(supportLevelLast),
                 style=label.style_label_left, color=color.new(color.red, 50),
                 textcolor=color.white, size=size.small)

        if not na(resistLevelLast)
            callWallLine := line.new(bar_index - 50, resistLevelLast, bar_index + 20, resistLevelLast,
                 color=color.new(color.lime, 30), width=2, style=line.style_dashed)
            callWallLabel := label.new(bar_index + 22, resistLevelLast,
                 "RESIST " + fmtInt(resistLevelLast),
                 style=label.style_label_left, color=color.new(color.lime, 50),
                 textcolor=color.white, size=size.small)

        if not na(magnetLevelLast) and math.abs(magnetLevelLast - curK) <= windowPts
            color magColor = magnetValidLast
                 ? color.new(color.yellow, 30)
                 : color.new(color.gray, 60)
            color txtColor = magnetValidLast ? color.black : color.gray
            string magTxt = magnetValidLast ? "⚡ MAGNET" : "⚡ FILTERED"

            magnetLabel := label.new(bar_index - 55, magnetLevelLast, magTxt,
                 style=label.style_label_right, color=magColor,
                 textcolor=txtColor, size=size.small)

    profileDrawn := true

// ================= 10-ROW TABLE =================
var table t = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 40))

if barstate.islast
    for i = 0 to 11
        table.cell(t, 0, i, "", text_color=color.white, bgcolor=color.new(color.black, 40))
        table.cell(t, 1, i, "", text_color=color.white, bgcolor=color.new(color.black, 40))

    int r = 0

    table.cell(t, 0, r, "OPTIONS FLOW", text_color=color.yellow, bgcolor=color.new(color.black, 20))
    table.cell(t, 1, r, "TODAY", text_color=color.yellow, bgcolor=color.new(color.black, 20))
    r += 1

    // ROW 1: BIAS
    table.cell(t, 0, r, "1. BIAS", text_color=color.white)
    if na(biasScoreLast)
        table.cell(t, 1, r, "N/A", text_color=color.gray)
    else
        string biasTxt = ""
        color biasCol = color.gray
        if biasScoreLast >= 30
            biasTxt := "▲▲ BULL +" + fmtInt(biasScoreLast)
            biasCol := color.lime
        else if biasScoreLast >= 10
            biasTxt := "▲ LEAN BULL +" + fmtInt(biasScoreLast)
            biasCol := color.green
        else if biasScoreLast <= -30
            biasTxt := "▼▼ BEAR " + fmtInt(biasScoreLast)
            biasCol := color.red
        else if biasScoreLast <= -10
            biasTxt := "▼ LEAN BEAR " + fmtInt(biasScoreLast)
            biasCol := color.orange
        else
            biasTxt := "◆ NEUTRAL " + fmtInt(biasScoreLast)
            biasCol := color.gray
        table.cell(t, 1, r, biasTxt, text_color=biasCol)
    r += 1

    // ROW 2: GAMMA
    table.cell(t, 0, r, "2. GAMMA", text_color=color.white)
    color gammaCol = gammaRegimeLast == "SHORT γ AMPLIFY"
         ? color.orange
         : gammaRegimeLast == "LONG γ DAMPEN"
             ? color.aqua
             : color.gray
    table.cell(t, 1, r, gammaRegimeLast, text_color=gammaCol)
    r += 1

    // ROW 3: VANNA
    table.cell(t, 0, r, "3. VANNA", text_color=color.white)
    color vannaCol = str.contains(vannaFlowLast, "↑")
         ? color.lime
         : str.contains(vannaFlowLast, "↓")
             ? color.red
             : color.gray
    table.cell(t, 1, r, vannaFlowLast, text_color=vannaCol)
    r += 1

    // ROW 4: SUPPORT
    table.cell(t, 0, r, "4. SUPPORT", text_color=color.white)
    if na(supportLevelLast)
        table.cell(t, 1, r, "NONE", text_color=color.gray)
    else
        string supTxt = fmtInt(supportLevelLast) + " (" + fmtInt(putWallDistLast) + "↓)"
        table.cell(t, 1, r, supTxt, text_color=color.white)
    r += 1

    // ROW 5: RESIST
    table.cell(t, 0, r, "5. RESIST", text_color=color.white)
    if na(resistLevelLast)
        table.cell(t, 1, r, "NONE", text_color=color.gray)
    else
        string resTxt = fmtInt(resistLevelLast) + " (" + fmtInt(callWallDistLast) + "↑)"
        table.cell(t, 1, r, resTxt, text_color=color.white)
    r += 1

    // ROW 6: MAGNET
    table.cell(t, 0, r, "6. MAGNET", text_color=color.white)
    if na(magnetLevelLast)
        table.cell(t, 1, r, "N/A", text_color=color.gray)
    else
        string magDir = magnetDistLast > 0 ? "↑" : magnetDistLast < 0 ? "↓" : "="
        string magTxt = fmtInt(magnetLevelLast) + " (" + fmtInt(math.abs(magnetDistLast)) + magDir + ")"
        color magCol = magnetValidLast ? color.white : color.gray
        table.cell(t, 1, r, magTxt, text_color=magCol)
    r += 1

    // ROW 7: REGIME
    table.cell(t, 0, r, "7. REGIME", text_color=color.white)
    color regCol = str.contains(regimeLast, "DEFENSIVE")
         ? color.red
         : str.contains(regimeLast, "PIN")
             ? color.purple
             : str.contains(regimeLast, "DOWN")
                 ? color.red
                 : str.contains(regimeLast, "UP")
                     ? color.lime
                     : color.orange
    table.cell(t, 1, r, regimeLast, text_color=regCol)
    r += 1

    // ROW 8: GEX FLIP
    table.cell(t, 0, r, "8. GEX FLIP", text_color=color.white)
    if na(transitionStrikeLast)
        table.cell(t, 1, r, "N/A", text_color=color.gray)
    else
        string flipDir = close >= transitionStrikeLast ? " (SUP)" : " (RES)"
        color flipCol = close >= transitionStrikeLast
             ? color.new(color.aqua, 0)
             : color.new(color.orange, 0)
        table.cell(t, 1, r, fmtInt(transitionStrikeLast) + flipDir, text_color=flipCol)
    r += 1

    // ROW 9: P/C RATIO
    table.cell(t, 0, r, "9. P/C RATIO", text_color=color.white)
    if na(pcRatioLast)
        table.cell(t, 1, r, "N/A", text_color=color.gray)
    else
        string pcTxt = ""
        color pcCol = color.gray
        if pcRatioLast >= 2.0
            pcTxt := fmt2(pcRatioLast) + " BEARISH"
            pcCol := color.red
        else if pcRatioLast >= 1.3
            pcTxt := fmt2(pcRatioLast) + " PUT HEAVY"
            pcCol := color.orange
        else if pcRatioLast <= 0.5
            pcTxt := fmt2(pcRatioLast) + " BULLISH"
            pcCol := color.lime
        else if pcRatioLast <= 0.8
            pcTxt := fmt2(pcRatioLast) + " CALL HEAVY"
            pcCol := color.green
        else
            pcTxt := fmt2(pcRatioLast) + " NEUTRAL"
            pcCol := color.gray
        table.cell(t, 1, r, pcTxt, text_color=pcCol)
    r += 1

    // ROW 10: SKEW (CLEAR LANGUAGE)
    table.cell(t, 0, r, "10. SKEW", text_color=color.white)
    color skewCol = skewDirLast == 1
         ? color.lime
         : skewDirLast == -1
             ? color.red
             : color.gray
    table.cell(t, 1, r, skewLast, text_color=skewCol)

// ================= Background
color bgCol = str.contains(regimeLast, "DEFENSIVE")
     ? color.new(color.gray, 94)
     : str.contains(regimeLast, "PIN")
         ? color.new(color.purple, 92)
         : str.contains(regimeLast, "DOWN")
             ? color.new(color.red, 94)
             : str.contains(regimeLast, "UP")
                 ? color.new(color.teal, 92)
                 : color.new(color.gray, 92)

bgcolor(bgCol)
plot(close, title="", color=color.new(color.white, 0), linewidth=2)
